{
  "name": "dawnbook",
  "version": "1.0.0",
  "description": "Platform open-source untuk kolaborasi dan publikasi buku edukasi berbasis Markdown dan mdBook.",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:headings": "bun run scripts/check-heading-colons.ts",
    "check:d1": "bun run scripts/check-d1-rate-limit.ts",
    "diagrams:render": "bun run scripts/render-diagrams.ts",
    "check:diagrams": "bun run scripts/check-diagrams.ts",
    "test:audit": "bun test",
    "pr:integrate": "bun run scripts/pr-integration-agent.ts",
    "pr:integrate:dry": "bun run scripts/pr-integration-agent.ts --dry-run",
    "check:covers": "bun run scripts/check-covers.ts",
    "og:preview": "bun run scripts/render-og-cards.ts"
  },
  "dependencies": {
    "wrangler": "^4.120.0"
  },
  "devDependencies": {
    "@fontsource/epilogue": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.2.2",
    "katex": "0.17.0",
    "lighthouse": "13.4.0",
    "miniflare": "4.20260714.0",
    "opentype.js": "1.3.4",
    "satori": "0.63.2"
  },
  "workspaces": [
    "apps/*"
  ]
}
